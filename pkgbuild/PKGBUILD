pkgname=skald
pkgver=0.2.0
pkgrel=1
pkgdesc='A desktop player for your Audible library, built on the Audible web player'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'qt6-webengine')
# Audible streams with Widevine, which Qt WebEngine borrows from a Chromium profile.
optdepends=('chromium: provides the Widevine module Audible playback needs')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/skald "$pkgdir/usr/bin/skald"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/skald.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/skald.svg"
  install -Dm644 "$startdir/skald.desktop" "$pkgdir/usr/share/applications/skald.desktop"
}
